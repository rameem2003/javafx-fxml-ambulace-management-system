<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ambulance.controller.EmergencyController"
            styleClass="root-pane">

    <left>
        <VBox styleClass="sidebar" prefWidth="240">
            <VBox styleClass="sidebar-brand" alignment="CENTER">
                <padding><Insets top="20" right="15" bottom="20" left="15"/></padding>
                <Label text="🚑" styleClass="brand-icon"/>
                <Label text="AmbulanceMS" styleClass="brand-title"/>
                <Label text="Management System" styleClass="brand-subtitle"/>
            </VBox>
            <Separator/>
            <VBox styleClass="nav-menu" spacing="5">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
                <Label text="MAIN MENU" styleClass="nav-header"/>
                <Button text="   📊  Dashboard" styleClass="nav-button" fx:id="btnDashboard"
                        onAction="#onDashboardClick" maxWidth="1.7976931348623157E308" prefHeight="42"/>
                <Button text="   🚑  Ambulances" styleClass="nav-button" fx:id="btnAmbulances"
                        onAction="#onAmbulancesClick" maxWidth="1.7976931348623157E308" prefHeight="42"/>
                <Button text="   🆘  Emergencies" styleClass="nav-button nav-active" fx:id="btnEmergencies"
                        onAction="#onEmergenciesClick" maxWidth="1.7976931348623157E308" prefHeight="42"/>
                <Button text="   👨‍⚕️  Drivers" styleClass="nav-button" fx:id="btnDrivers"
                        onAction="#onDriversClick" maxWidth="1.7976931348623157E308" prefHeight="42"/>
                <Separator/>
                <Label text="SYSTEM" styleClass="nav-header"/>
                <Button text="   📋  Reports" styleClass="nav-button" maxWidth="1.7976931348623157E308" prefHeight="42"/>
                <Button text="   ⚙️  Settings" styleClass="nav-button" maxWidth="1.7976931348623157E308" prefHeight="42"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content">
            <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="15">
                <padding><Insets top="15" right="25" bottom="15" left="25"/></padding>
                <VBox>
                    <Label text="Emergency Requests" styleClass="page-title"/>
                    <Label text="Track and manage all emergency requests" styleClass="page-subtitle"/>
                </VBox>
                <Region maxWidth="1.7976931348623157E308"/>
                <TextField fx:id="searchField" promptText="🔍 Search requests..." styleClass="search-field" prefWidth="250" prefHeight="36" onKeyReleased="#onSearch"/>
            </HBox>
            <Separator/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="20">
                    <padding><Insets top="20" right="25" bottom="25" left="25"/></padding>

                    <HBox spacing="18" styleClass="stat-row">
                        <HBox styleClass="stat-card stat-purple" spacing="12" alignment="CENTER_LEFT">
                            <Label text="📋" styleClass="stat-icon"/>
                            <VBox spacing="2">
                                <Label text="Total Requests" styleClass="stat-label"/>
                                <Label fx:id="totalRequests" text="0" styleClass="stat-value"/>
                            </VBox>
                        </HBox>
                        <HBox styleClass="stat-card stat-red" spacing="12" alignment="CENTER_LEFT">
                            <Label text="🔴" styleClass="stat-icon"/>
                            <VBox spacing="2">
                                <Label text="Critical" styleClass="stat-label"/>
                                <Label fx:id="criticalCount" text="0" styleClass="stat-value"/>
                            </VBox>
                        </HBox>
                        <HBox styleClass="stat-card stat-orange" spacing="12" alignment="CENTER_LEFT">
                            <Label text="🟡" styleClass="stat-icon"/>
                            <VBox spacing="2">
                                <Label text="Pending" styleClass="stat-label"/>
                                <Label fx:id="pendingCount" text="0" styleClass="stat-value"/>
                            </VBox>
                        </HBox>
                        <HBox styleClass="stat-card stat-green" spacing="12" alignment="CENTER_LEFT">
                            <Label text="🟢" styleClass="stat-icon"/>
                            <VBox spacing="2">
                                <Label text="Completed" styleClass="stat-label"/>
                                <Label fx:id="completedCount" text="0" styleClass="stat-value"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <VBox styleClass="card" spacing="10">
                        <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="All Emergency Requests" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                            <Region maxWidth="1.7976931348623157E308"/>
                            <Button text="➕ Add" styleClass="btn-add" onAction="#onAddClick"/>
                            <Button text="✏️ Edit" styleClass="btn-edit" onAction="#onEditClick"/>
                            <Button text="🗑 Delete" styleClass="btn-delete" onAction="#onDeleteClick"/>
                            <Button text="🔄 Refresh" styleClass="btn-refresh" onAction="#onRefreshClick"/>
                        </HBox>
                        <TableView fx:id="emergencyTable" prefHeight="450" styleClass="styled-table">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="colPatient" text="Patient" prefWidth="140"/>
                                <TableColumn fx:id="colLocation" text="Location" prefWidth="160"/>
                                <TableColumn fx:id="colPriority" text="Priority" prefWidth="90"/>
                                <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                                <TableColumn fx:id="colTime" text="Time" prefWidth="100"/>
                                <TableColumn fx:id="colAmbulance" text="Ambulance" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
